{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "font": {
      "$ref": "#/$defs/FontConfig"
    },
    "colors": {
      "description": "Overrides applied on top of the selected theme.",
      "$ref": "#/$defs/ColorOverrides"
    },
    "terminal": {
      "$ref": "#/$defs/TerminalConfig"
    },
    "ui": {
      "$ref": "#/$defs/UiConfig"
    },
    "editor": {
      "$ref": "#/$defs/EditorConfig"
    },
    "keybindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UserKeyBinding"
      }
    },
    "profiles": {
      "description": "Named terminal setups for `terminal.newTabWithProfile`. Ignored in\nthe workspace layer, like `terminal.shell`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TerminalProfile"
      }
    },
    "agents": {
      "description": "ACP adapters available to `agent.newSession`. Ignored in workspace\nconfiguration because repositories must not choose executables.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentConfig"
      }
    },
    "providers": {
      "description": "Model providers Forge injects into agents (§17.7). User layer only.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderConfig"
      }
    },
    "router": {
      "description": "Which provider serves each task class (§17.7).",
      "$ref": "#/$defs/RouterConfig"
    },
    "mcp_servers": {
      "description": "MCP servers handed to agents in `session/new` (§18). User layer only:\na repository must not make Forge start executables.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/McpServerConfig"
      }
    },
    "lsp": {
      "$ref": "#/$defs/LspConfig"
    },
    "languages": {
      "description": "User-only language/server overrides; never execute repo-supplied commands.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LanguageDefinition"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FontConfig": {
      "type": "object",
      "properties": {
        "family": {
          "description": "Font family; generic names such as `monospace` resolve to an installed\nmonospace family.",
          "type": "string",
          "default": "monospace"
        },
        "size": {
          "description": "Font size in pixels.",
          "type": "number",
          "format": "float",
          "default": 14.0
        },
        "line_height": {
          "description": "Cell height as a multiple of the font size.",
          "type": "number",
          "format": "float",
          "default": 1.2999999523162842
        }
      },
      "additionalProperties": false
    },
    "ColorOverrides": {
      "description": "Per-key colour overrides; unset keys come from the theme.",
      "type": "object",
      "properties": {
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/HexColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/HexColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/HexColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/HexColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_opacity": {
          "description": "Opacity of the selection overlay, 0–1.",
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "accent": {
          "description": "Status line text.",
          "anyOf": [
            {
              "$ref": "#/$defs/HexColor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "HexColor": {
      "description": "Colour as #rrggbb",
      "type": "string",
      "pattern": "^#?[0-9a-fA-F]{6}$"
    },
    "TerminalConfig": {
      "type": "object",
      "properties": {
        "shell": {
          "description": "Program to run; defaults to `$SHELL`, then `/bin/sh`. Ignored in the\nworkspace layer.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "args": {
          "description": "Ignored in the workspace layer.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "padding": {
          "description": "Space between the pane edge and the grid, in pixels.",
          "type": "number",
          "format": "float",
          "default": 16.0
        },
        "show_status": {
          "description": "Show the \"Forge · cols×rows · status\" line above the grid.",
          "type": "boolean",
          "default": true
        },
        "shell_integration": {
          "description": "Inject Forge's shell integration (OSC 133 prompt marks, OSC 7 cwd)\ninto bash, zsh and fish started without custom `args`.",
          "type": "boolean",
          "default": true
        },
        "clipboard_write": {
          "description": "What to do when a program writes the clipboard (OSC 52).",
          "$ref": "#/$defs/ClipboardPolicy"
        },
        "open_file_command": {
          "description": "Command that opens `file:line` references from Ctrl+click; `{file}`,\n`{line}` and `{column}` are substituted. Empty uses the desktop\nopener (`xdg-open`/`open`).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "ClipboardPolicy": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        {
          "description": "Show a confirmation the first time per tab.",
          "type": "string",
          "const": "ask"
        }
      ]
    },
    "UiConfig": {
      "type": "object",
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "theme": {
          "description": "Built-in theme (`forge-dark`, `forge-light`) or the stem of a file in\n`themes/` next to the config.",
          "type": "string",
          "default": "forge-dark"
        }
      },
      "additionalProperties": false
    },
    "Language": {
      "type": "string",
      "enum": [
        "spanish",
        "english"
      ]
    },
    "EditorConfig": {
      "type": "object",
      "properties": {
        "tab_size": {
          "description": "Columns per tab stop; also the width of a soft tab.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 4
        },
        "indent_with_tabs": {
          "description": "Insert `\\t` instead of spaces on Tab.",
          "type": "boolean",
          "default": false
        },
        "line_numbers": {
          "type": "boolean",
          "default": true
        },
        "autosave_ms": {
          "description": "Save dirty files this long after the last edit; 0 disables.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "word_wrap": {
          "description": "Wrap long lines at the pane width (`Alt+Z` toggles per editor).",
          "type": "boolean",
          "default": false
        },
        "minimap": {
          "description": "Show the minimap strip at the right of editors.",
          "type": "boolean",
          "default": true
        },
        "modal": {
          "description": "Helix-like modal editing: files open in Normal mode (`i` inserts,\n`Esc` returns, `hjkl`/`w`/`b`/`0`/`$`/`G` move, `x`/`d` delete,\n`u`/`U` undo/redo, `v` extends, `y`/`p` copy/paste, `/` finds).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "UserKeyBinding": {
      "description": "User-owned binding declaration, accepted from `config.toml`.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Command id, e.g. `terminal.newTab`.",
          "type": "string"
        },
        "keys": {
          "description": "Chord such as `ctrl+shift+p`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "command",
        "keys"
      ]
    },
    "TerminalProfile": {
      "description": "A way to start a terminal: program, arguments, directory, environment.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "shell": {
          "description": "Program to run; defaults to `terminal.shell`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cwd": {
          "description": "Starting directory; defaults to the active tab's.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "AgentConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "command": {
          "type": "string",
          "default": ""
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "auth_method": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "provider": {
          "description": "Provider used when the router has nothing for the task class;\nempty keeps the agent's own login/model.",
          "type": "string",
          "default": ""
        },
        "worktree": {
          "description": "Run each session in its own git worktree (`<config>/worktrees/…`)\nso agents never edit the checkout you are working in.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "ProviderConfig": {
      "description": "A model provider: how an agent should reach a model, expressed as the\nenvironment the agent's CLI already understands. Keys are never written\nin the config: `api_key_env` names the variable that holds one.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model": {
          "description": "Model id passed to the agent (`gpt-5`, `claude-opus-5`, …); empty\nkeeps the agent's default.",
          "type": "string",
          "default": ""
        },
        "base_url": {
          "description": "OpenAI-compatible or custom endpoint; empty keeps the default.",
          "type": "string",
          "default": ""
        },
        "api_key_env": {
          "description": "Environment variable holding the API key; empty relies on the\nagent's own login (Codex with the `ChatGPT` subscription, Claude Code\nwith `claude login`).",
          "type": "string",
          "default": ""
        },
        "free": {
          "description": "Whether requests are free of charge (local models, free tiers);\nthe router prefers these for `trivial` tasks.",
          "type": "boolean",
          "default": false
        },
        "env": {
          "description": "Extra environment for this provider, verbatim.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "ProviderKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "google"
          ]
        },
        {
          "description": "Any server speaking the `OpenAI` API (Ollama, LM Studio, vLLM…).",
          "type": "string",
          "const": "openai-compatible"
        }
      ]
    },
    "RouterConfig": {
      "description": "Provider name per task class; an empty entry means \"the agent's own\ndefault\". `/trivial`, `/normal` or `/deep` at the start of a prompt\npicks the class; `default_class` applies otherwise.",
      "type": "object",
      "properties": {
        "trivial": {
          "type": "string",
          "default": ""
        },
        "normal": {
          "type": "string",
          "default": ""
        },
        "deep": {
          "type": "string",
          "default": ""
        },
        "default_class": {
          "$ref": "#/$defs/TaskClass"
        }
      },
      "additionalProperties": false
    },
    "TaskClass": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "normal"
          ]
        },
        {
          "description": "Renames, one-liners, questions: cheap/free models are enough.",
          "type": "string",
          "const": "trivial"
        },
        {
          "description": "Architecture, debugging across files: the strongest model.",
          "type": "string",
          "const": "deep"
        }
      ]
    },
    "McpServerConfig": {
      "description": "An MCP server the agent connects to directly (ACP `session/new`).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        },
        "command": {
          "type": "string",
          "default": ""
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "url": {
          "description": "Streamable HTTP endpoint (HTTPS, or HTTP on loopback only).",
          "type": "string",
          "default": ""
        },
        "headers": {
          "description": "Header values expressed as `${ENV_VAR}` references, never tokens.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "agents": {
          "description": "Empty means all agents; otherwise matches configured agent names.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "http"
      ]
    },
    "LspConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "debounce_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 75
        },
        "startup_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 500
        },
        "idle_shutdown_secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 1800
        }
      },
      "additionalProperties": false
    },
    "LanguageDefinition": {
      "description": "Language definition mapping file extensions to LSP servers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServerConfig"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "ServerConfig": {
      "description": "Configuration of a specific language server executable.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "root_markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "initialization_options": {
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ]
    }
  }
}
